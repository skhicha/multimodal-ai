# Which LLM backs the Ask AI assistant: "mock" (default, offline/template answers,
# no API key needed) or "anthropic" (real Claude answers over your retrieved media).
LLM_PROVIDER=mock

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Model used when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5

# Whisper model size for audio transcription: tiny, base, small...
# "tiny" is fastest and recommended for a MacBook Air M1 / CPU-only box.
WHISPER_MODEL=tiny

# Where uploaded media + the SQLite DB live, relative to backend/
DATA_DIR=./data

# Secret used to sign JWT access/refresh tokens. CHANGE THIS before any
# real deployment -- generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-value-in-production

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Email / OTP mailer (backend/app/services/mailer.py) ---
# Leaving SMTP_HOST or SMTP_USER unset is fine for the demo: emails just get
# printed to the backend console, prefixed "[DEV MODE -- email not sent,
# SMTP not configured]", instead of actually being sent.
#
# For a real send, the easiest free option is a Gmail App Password:
#   1. Turn on 2-Step Verification on your Google account (required).
#   2. Go to https://myaccount.google.com/apppasswords and generate an
#      "App Password" -- a 16-character code made just for one app/device.
#      This is NOT your normal Gmail password; it only works for SMTP login
#      and can be revoked separately, so it's safe to use here.
#   3. Use SMTP_USER=your@gmail.com and SMTP_PASSWORD=<the app password>.
# Alternatively, a free Mailtrap or Ethereal test SMTP inbox works great for
# a demo since it never actually emails anyone -- just catches the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Google Sign-In (SSO) ---
# Entirely optional: leaving these unset is fine -- the "Sign in with
# Google" button still renders, but clicking it shows an honest "Google
# sign-in isn't configured" message instead of breaking.
#
# To turn it on (free):
#   1. Go to https://console.cloud.google.com/ -> create a project (or pick
#      an existing one).
#   2. APIs & Services -> OAuth consent screen -> set it up as "External",
#      fill in an app name and your email, and add your own Google account
#      under "Test users" (while the app is unpublished, only test users
#      can sign in -- totally fine for a local capstone demo).
#   3. APIs & Services -> Credentials -> Create Credentials -> OAuth client
#      ID -> Application type "Web application".
#   4. Under "Authorized redirect URIs" add EXACTLY:
#      http://localhost:8000/api/auth/google/callback
#   5. Copy the generated Client ID and Client Secret below.
# GOOGLE_REDIRECT_URI and FRONTEND_URL only need changing if you run the
# backend/frontend on different ports/hosts than the defaults.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
