# SonaVault environment configuration (pydantic-settings, env_prefix="SV_")
# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32

# --- Core / network ---
SV_ENV=development
SV_PUBLIC_ORIGIN=https://sonavault.local
SV_CORS_ORIGINS=https://sonavault.local
SV_DATABASE_URL=postgresql+asyncpg://sonavault:sonavault@postgres:5432/sonavault
SV_REDIS_URL=redis://:changeme@redis:6379/0
SV_REDIS_PASSWORD=changeme
SV_QDRANT_URL=http://qdrant:6333
SV_QUEUE_BACKEND=redis   # redis | in-process

# --- Auth / crypto ---
SV_JWT_ED25519_PRIVATE_KEY_PATH=/run/secrets/jwt_ed25519_private.pem
SV_JWT_ACCESS_TTL_MIN=15
SV_JWT_REFRESH_TTL_DAYS=7
SV_ARGON2_MEMORY_KIB=65536
SV_ARGON2_TIME_COST=3
SV_ARGON2_PARALLELISM=2
SV_WEBAUTHN_RP_ID=sonavault.local
SV_WEBAUTHN_RP_NAME=SonaVault
SV_MASTER_KEK_B64=
SV_BLIND_INDEX_KEY_B64=
SV_INTERNAL_SERVICE_TOKEN=
SV_MEDIAMTX_WEBHOOK_SECRET=
SV_ENFORCE_MFA_TIER_MIN=3
SV_ENFORCE_MFA_ALL=false

# --- AI sidecars / feature flags ---
SV_SPEECH_SIDECAR_URL=http://speech-audio-gpu:8001
SV_NLP_SIDECAR_URL=http://nlp-retrieval-gpu:8002
SV_VLLM_BASE_URL=http://vllm-moe-gpu:8000
SV_VLLM_MODEL_ID=nvidia/Qwen3-30B-A3B-NVFP4
SV_MT_MODEL_ID=google/madlad400-3b-mt
SV_FEATURE_VLLM_ENABLED=true

# --- Storage paths ---
SV_BLOB_ROOT=/data/blobs
SV_MODEL_ROOT=/data/models
SV_CACHE_ROOT=/data/cache
